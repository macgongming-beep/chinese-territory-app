# 테스트 전용 Supabase 프로젝트 설정
#
# 이 파일을 .env.test.local 로 복사해서 값을 채운다.
#
# ⚠ .env.local 을 복사하지 말 것. 그건 운영이다.
#    운영 ref 를 넣으면 scripts/testEnvGuard.js 가 테스트를 중단시킨다.
#
# 테스트 프로젝트 만드는 법:
#   1. supabase.com 에서 새 프로젝트 (무료 티어)
#   2. supabase/baseline.sql + baseline-extras.sql 을 SQL Editor 에서 실행
#   3. supabase/seed.test.sql 을 실행해 테스트 계정과 최소 데이터를 넣는다
#
# 자세한 절차는 docs/새-회중-설치.md

VITE_SUPABASE_URL=https://itjlykpjmlcvanqpmkmc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# 지도는 운영과 같은 키를 써도 된다 (읽기 전용 SDK)
VITE_NAVER_MAP_CLIENT_ID=

# 테스트 로그인 계정 — supabase/seed.test.sql 이 만든다
TEST_LOGIN_ID=test-admin
TEST_LOGIN_PIN=1234
